# =============================================================
# Variables d'environnement pour le formulaire de contact (Brevo)
# -------------------------------------------------------------
# 1. Copie ce fichier en `.env.local` à la racine du projet
# 2. Remplis les 3 valeurs ci-dessous
# 3. Lance `vercel dev` (au lieu de `ng serve`) pour tester en local
#
# En production : ces variables sont configurées directement dans
# Vercel → Settings → Environment Variables (puis redéployer).
#
# ⚠️  Ne commit JAMAIS le fichier `.env.local` (il est déjà dans .gitignore).
# =============================================================

# Clé API Brevo (générée sur app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice vérifiée dans Brevo (Senders, Domains & Dedicated IPs)
SENDER_EMAIL=contact@ton-domaine.com

# Adresse où tu reçois les notifications de contact
OWNER_EMAIL=zamoalyssa@gmail.com
